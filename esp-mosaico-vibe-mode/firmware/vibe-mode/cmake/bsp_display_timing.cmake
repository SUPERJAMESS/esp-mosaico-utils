# Product-local timing override for the pinned BSP (05e067de...). Compile a
# generated copy so dependency downloads remain intact and clean builds use
# the same timings. Fail closed if a BSP update changes the expected commands.
function(vibe_configure_bsp_display_timing)
    idf_component_get_property(vibe_bsp_dir esp-mosaico-bsp COMPONENT_DIR)
    idf_component_get_property(vibe_bsp_lib esp-mosaico-bsp COMPONENT_LIB)
    set(vibe_display_original "${vibe_bsp_dir}/onboard/display.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${vibe_display_original}")
    file(READ "${vibe_display_original}" vibe_display_source)
    foreach(command 0x11 0x29)
        set(before "{${command}, NULL, 0, 600}")
        string(REGEX MATCHALL "\\{${command}, NULL, 0, 600\\}" matches "${vibe_display_source}")
        list(LENGTH matches count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Review Vibe LCD timing override: expected one ${before} in pinned BSP")
        endif()
        string(REPLACE "${before}" "{${command}, NULL, 0, 100}" vibe_display_source "${vibe_display_source}")
    endforeach()
    set(vibe_display_generated "${CMAKE_CURRENT_BINARY_DIR}/vibe_bsp_display.c")
    set(previous "")
    if(EXISTS "${vibe_display_generated}")
        file(READ "${vibe_display_generated}" previous)
    endif()
    if(NOT previous STREQUAL vibe_display_source)
        file(WRITE "${vibe_display_generated}" "${vibe_display_source}")
    endif()
    get_target_property(vibe_bsp_sources ${vibe_bsp_lib} SOURCES)
    set(replaced FALSE)
    set(vibe_bsp_patched_sources "")
    foreach(source IN LISTS vibe_bsp_sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${vibe_bsp_dir}")
        if(absolute STREQUAL vibe_display_original)
            list(APPEND vibe_bsp_patched_sources "${vibe_display_generated}")
            set(replaced TRUE)
        else()
            list(APPEND vibe_bsp_patched_sources "${source}")
        endif()
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "Pinned BSP no longer compiles onboard/display.c; review Vibe LCD timing override")
    endif()
    set_property(TARGET ${vibe_bsp_lib} PROPERTY SOURCES "${vibe_bsp_patched_sources}")
endfunction()
vibe_configure_bsp_display_timing()
