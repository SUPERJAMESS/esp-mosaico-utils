# Guard BQ27220 initialization against treating I2C read/echo failures as a
# profile mismatch that triggers CONFIG_UPDATE writes. Keep the managed 0.1.3
# component untouched and fail closed on any unreviewed upstream revision.
function(vibe_configure_bq27220_profile_read_guard)
    idf_build_get_property(vibe_build_components BUILD_COMPONENTS)
    set(vibe_bq_component "")
    foreach(candidate espressif__bq27220 bq27220)
        if(candidate IN_LIST vibe_build_components)
            set(vibe_bq_component "${candidate}")
            break()
        endif()
    endforeach()
    if(NOT vibe_bq_component)
        message(FATAL_ERROR "Vibe Mode requires espressif/bq27220 for battery telemetry")
    endif()
    idf_component_get_property(vibe_bq_dir ${vibe_bq_component} COMPONENT_DIR)
    idf_component_get_property(vibe_bq_lib ${vibe_bq_component} COMPONENT_LIB)
    idf_build_get_property(vibe_python PYTHON)
    set(vibe_bq_original "${vibe_bq_dir}/bq27220.c")
    set(vibe_bq_transform "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/patch_bq27220_profile_read_guard.py")
    set(vibe_bq_generated "${CMAKE_BINARY_DIR}/vibe_bq27220.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${vibe_bq_original}" "${vibe_bq_transform}")
    execute_process(COMMAND "${vibe_python}" "${vibe_bq_transform}"
        --source "${vibe_bq_original}" --output "${vibe_bq_generated}"
        RESULT_VARIABLE vibe_bq_result OUTPUT_VARIABLE vibe_bq_record
        ERROR_VARIABLE vibe_bq_error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT vibe_bq_result EQUAL 0)
        message(FATAL_ERROR "Vibe BQ27220 profile-read guard failed: ${vibe_bq_error}")
    endif()
    string(JSON vibe_bq_record SET "${vibe_bq_record}" source "\"${vibe_bq_original}\"")
    string(JSON vibe_bq_record SET "${vibe_bq_record}" transform "\"${vibe_bq_transform}\"")
    string(JSON vibe_bq_record SET "${vibe_bq_record}" cmake "\"${CMAKE_CURRENT_FUNCTION_LIST_FILE}\"")
    file(WRITE "${CMAKE_BINARY_DIR}/vibe_bq27220_profile_read_guard_patch.json" "${vibe_bq_record}\n")
    get_target_property(vibe_bq_sources ${vibe_bq_lib} SOURCES)
    set(vibe_bq_replaced 0)
    set(vibe_bq_patched_sources "")
    foreach(source IN LISTS vibe_bq_sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${vibe_bq_dir}")
        if(absolute STREQUAL vibe_bq_original)
            list(APPEND vibe_bq_patched_sources "${vibe_bq_generated}")
            math(EXPR vibe_bq_replaced "${vibe_bq_replaced} + 1")
        else()
            list(APPEND vibe_bq_patched_sources "${source}")
        endif()
    endforeach()
    if(NOT vibe_bq_replaced EQUAL 1)
        message(FATAL_ERROR "Expected exactly one pinned BQ27220 source in ${vibe_bq_component}")
    endif()
    set_property(TARGET ${vibe_bq_lib} PROPERTY SOURCES "${vibe_bq_patched_sources}")
endfunction()
vibe_configure_bq27220_profile_read_guard()
