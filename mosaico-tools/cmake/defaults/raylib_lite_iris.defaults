# Raylib-specific overrides of the shared blank_game product defaults.
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico Raylib Game"
# CONFIG_ESP_IRIS_TRANSPORT_TCP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_IRIS_ENABLE=y
CONFIG_ESP_IRIS_TRANSPORT_USB=y

# CONFIG_ESP_MOSAICO_APP_AUTO_ACCEPT is not set
