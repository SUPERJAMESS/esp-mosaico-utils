{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "website",
    "device"
  ],
  "properties": {
    "schema": {
      "const": "mosaico-ideas/project-release/1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "categories"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "smart-home",
              "sensors",
              "display",
              "audio",
              "communication",
              "motor"
            ]
          }
        },
        "boards": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "camera",
              "ethernet",
              "battery"
            ]
          }
        },
        "tags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "license": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "external_links": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url",
              "platform"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https?://"
              },
              "platform": {
                "enum": [
                  "github",
                  "oshwhub",
                  "makerworld",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    "firmware": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readme"
      ],
      "properties": {
        "readme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "changelog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "covers": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "attachments": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_locale",
        "presentations"
      ],
      "properties": {
        "default_locale": {
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "presentations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-CN",
            "en"
          ],
          "properties": {
            "zh-CN": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "description",
                    "font"
                  ],
                  "properties": {
                    "mode": {
                      "const": "generate",
                      "default": "generate"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "font": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "icon": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "display"
                  ],
                  "properties": {
                    "mode": {
                      "const": "prebuilt"
                    },
                    "display": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                }
              ]
            },
            "en": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "description",
                    "font"
                  ],
                  "properties": {
                    "mode": {
                      "const": "generate",
                      "default": "generate"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "font": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "icon": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "display"
                  ],
                  "properties": {
                    "mode": {
                      "const": "prebuilt"
                    },
                    "display": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mosaico Ideas local author configuration",
  "description": "Input to project package. Source paths are relative to the application root. Firmware may instead be supplied by --bundle. The generated immutable ZIP uses mosaico-ideas/release/1."
}
